  "name": "ngram-type",
  "title": "Ngram Type",
  "description": "Practice common n-grams and words directly from Raycast.",
  "icon": "extension-icon.png",
  "author": "imbrian",
  "categories": [
    "Productivity"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "practice",
